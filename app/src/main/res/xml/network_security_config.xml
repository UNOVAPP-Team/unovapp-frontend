<?xml version="1.0" encoding="utf-8"?>
<!--
    Politique de sécurité réseau.
    - Par défaut : tout trafic HTTP (cleartext) est bloqué ; seul HTTPS est autorisé.
    - Seule exception : localhost / 10.0.2.2 (émulateur) pour le débogage local.

    Depuis le 2026-07-28, la passerelle est servie en HTTPS sur api.unovapp.com :
    l'exception cleartext pour l'ancienne IP 152.239.118.90 a été retirée (cette IP
    n'existe plus, et l'autoriser en clair ne serait qu'une surface d'attaque morte).
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- HTTP autorisé uniquement sur localhost (émulateur / tests locaux). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

</network-security-config>
